{
  "name": "cozagrac",
  "version": "0.0.0",
  "description": "",
  "main": "index.js",
  "private": true,
  "workspaces": [
    "apps/*"
  ],
  "scripts": {
    "dev": "concurrently -n CLIENT,SERVER,TYPECHECK -c magenta,green,blue \"npm run dev -w frontend\" \"npm run dev -w backend\" \"npm run typecheck -w backend\"",
    "build": "npm run build -w @cozagrac/shared && npm run build -w frontend && npm run build -w backend",
    "lint": "npm run lint -w frontend && npm run lint -w backend",
    "test": "npm run test -w backend"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/kvbson/CoZagrac.git"
  },
  "keywords": [],
  "author": "",
  "license": "Apache-2.0",
  "bugs": {
    "url": "https://github.com/kvbson/CoZagrac/issues"
  },
  "homepage": "https://github.com/kvbson/CoZagrac#readme",
  "devDependencies": {
    "@eslint/js": "^9.39.2",
    "@types/node": "^25.0.9",
    "concurrently": "^9.2.1",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-prettier": "^5.5.5",
    "globals": "^17.0.0",
    "prettier": "^3.8.0",
    "typescript-eslint": "^8.53.0"
  }
}
