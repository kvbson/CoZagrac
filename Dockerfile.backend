FROM node:22-alpine

WORKDIR /app

COPY package*.json ./
COPY apps/backend/package*.json ./apps/backend/
COPY apps/frontend/package*.json ./apps/frontend/
COPY apps/shared/package*.json ./apps/shared/

RUN npm install

COPY . .

RUN npm run build

EXPOSE 3001

CMD ["node", "apps/backend/dist/src/index.js"]