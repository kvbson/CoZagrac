  "views": {
    "public.genre_names_for_game_view": {
      "name": "genre_names_for_game_view",
      "schema": "public",
      "columns": {
        "steam_appid": {
          "name": "steam_appid",
          "type": "integer",
          "primaryKey": false,
          "notNull": false
        },
        "genres": {
          "name": "genres",
          "type": "varchar[]",
          "primaryKey": false,
          "notNull": false
        }
      },
      "isExisting": false,
      "definition": "SELECT steam_appid, ( SELECT array_agg(g.name ORDER BY g.name) AS array_agg FROM game_genres gg JOIN genres g ON g.id = gg.genre_id WHERE gg.steam_appid = gi.steam_appid) AS genres FROM game_info gi WHERE name::text = 'Shadow of the Tomb Raider: Definitive Edition'::text",
      "materialized": false
    }
  },
