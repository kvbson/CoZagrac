generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model categories {
  id                String            @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  steam_category_id Int?
  name              String?           @unique @db.VarChar
  game_categories   game_categories[]
  user_categories   user_categories[]
}

model game_categories {
  steam_appid Int
  category_id String     @db.Uuid
  categories  categories @relation(fields: [category_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
  game_info   game_info  @relation(fields: [steam_appid], references: [steam_appid], onDelete: Cascade, onUpdate: NoAction)

  @@id([steam_appid, category_id])
  @@index([category_id], map: "idx_game_categories_category_id")
  @@index([steam_appid], map: "idx_game_categories_steam_appid")
}

model game_embeddings {
  id          String                @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  steam_appid Int
  embedding   Unsupported("vector")
  model_name  String?               @db.VarChar
  created_at  DateTime?             @default(now()) @db.Timestamptz(6)
  game_info   game_info             @relation(fields: [steam_appid], references: [steam_appid], onDelete: Cascade, onUpdate: NoAction)

  @@index([steam_appid], map: "idx_game_embeddings_steam_appid")
  @@index([embedding], map: "idx_game_embeddings_vector")
}

model game_genres {
  steam_appid Int
  genre_id    String    @db.Uuid
  genres      genres    @relation(fields: [genre_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
  game_info   game_info @relation(fields: [steam_appid], references: [steam_appid], onDelete: Cascade, onUpdate: NoAction)

  @@id([steam_appid, genre_id])
  @@index([genre_id], map: "idx_game_genres_genre_id")
  @@index([steam_appid], map: "idx_game_genres_steam_appid")
}

model game_info {
  steam_appid             Int                      @id
  name                    String?                  @db.VarChar
  short_description       String?
  detailed_description    String?
  about_the_game          String?
  is_free                 Boolean?
  required_age            Int?
  platform_windows        Boolean?
  platform_mac            Boolean?
  platform_linux          Boolean?
  header_image            String?                  @db.VarChar
  capsule_image           String?                  @db.VarChar
  background              String?                  @db.VarChar
  website                 String?                  @db.VarChar
  app_url                 String?                  @db.VarChar
  release_coming_soon     Boolean?
  release_date            DateTime?                @db.Date
  price_currency          String?                  @db.VarChar
  price_initial           Int?
  price_final             Int?
  price_initial_formatted String?                  @db.VarChar
  price_final_formatted   String?                  @db.VarChar
  price_discount_percent  String?                  @db.VarChar
  pc_minimum              String?
  pc_recommended          String?
  mac_minimum             String?
  mac_recommended         String?
  linux_minimum           String?
  linux_recommended       String?
  search_vector           Unsupported("tsvector")?
  game_categories         game_categories[]
  game_embeddings         game_embeddings[]
  game_genres             game_genres[]
  game_movies             game_movies[]
  game_publishers         game_publishers[]
  game_reviews            game_reviews[]
  game_screenshots        game_screenshots[]

  @@index([is_free], map: "idx_game_info_is_free")
  @@index([release_date], map: "idx_game_info_release_date")
  @@index([search_vector], map: "idx_game_info_search_vector", type: Gin)
}

model game_movies {
  steam_appid Int
  movie_id    Int
  name        String?   @db.VarChar
  thumbnail   String?   @db.VarChar
  url         String?   @db.VarChar
  game_info   game_info @relation(fields: [steam_appid], references: [steam_appid], onDelete: Cascade, onUpdate: NoAction)

  @@id([steam_appid, movie_id])
  @@index([steam_appid], map: "idx_game_movies_steam_appid")
}

model game_publishers {
  steam_appid  Int
  publisher_id Int
  name         String?   @db.VarChar
  game_info    game_info @relation(fields: [steam_appid], references: [steam_appid], onDelete: Cascade, onUpdate: NoAction)

  @@id([steam_appid, publisher_id])
  @@index([steam_appid], map: "idx_game_publishers_steam_appid")
}

model game_reviews {
  steam_appid         Int
  recommendation_id   Int
  review              String?
  voted_up            Boolean?
  votes_up            Int?
  votes_funny         Int?
  weighted_vote_score Float?
  steam_purchase      Boolean?
  comment_count       Int?
  review_created      DateTime? @db.Date
  game_info           game_info @relation(fields: [steam_appid], references: [steam_appid], onDelete: Cascade, onUpdate: NoAction)

  @@id([steam_appid, recommendation_id])
  @@index([steam_appid], map: "idx_game_reviews_steam_appid")
}

model game_screenshots {
  steam_appid    Int
  screenshot_id  Int
  path_thumbnail String?   @db.VarChar
  path_full      String?   @db.VarChar
  game_info      game_info @relation(fields: [steam_appid], references: [steam_appid], onDelete: Cascade, onUpdate: NoAction)

  @@id([steam_appid, screenshot_id])
  @@index([steam_appid], map: "idx_game_screenshots_steam_appid")
}

model genres {
  id             String        @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  steam_genre_id Int?
  name           String?       @unique @db.VarChar
  game_genres    game_genres[]
  user_genres    user_genres[]
}

model sessions {
  id      String   @id @db.VarChar
  user_id String?  @db.Uuid
  sess    Json
  expire  DateTime @db.Timestamptz(6)
  users   users?   @relation(fields: [user_id], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@index([expire], map: "idx_sessions_expire")
}

model tags {
  id           String      @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  steam_tag_id Int?
  name         String?     @unique @db.VarChar
  user_tags    user_tags[]
}

model user_categories {
  user_id     String     @db.Uuid
  category_id String     @db.Uuid
  categories  categories @relation(fields: [category_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
  users       users      @relation(fields: [user_id], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@id([user_id, category_id])
  @@index([user_id], map: "idx_user_categories_user_id")
}

model user_embeddings {
  id         String                @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  user_id    String                @db.Uuid
  embedding  Unsupported("vector")
  model_name String?               @db.VarChar
  created_at DateTime?             @default(now()) @db.Timestamptz(6)
  users      users                 @relation(fields: [user_id], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@index([user_id], map: "idx_user_embeddings_user_id")
  @@index([embedding], map: "idx_user_embeddings_vector")
}

model user_genres {
  user_id  String @db.Uuid
  genre_id String @db.Uuid
  genres   genres @relation(fields: [genre_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
  users    users  @relation(fields: [user_id], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@id([user_id, genre_id])
  @@index([user_id], map: "idx_user_genres_user_id")
}

model user_tags {
  user_id String @db.Uuid
  tag_id  String @db.Uuid
  tags    tags   @relation(fields: [tag_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
  users   users  @relation(fields: [user_id], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@id([user_id, tag_id])
  @@index([user_id], map: "idx_user_tags_user_id")
}

/// This model or at least one of its fields has comments in the database, and requires an additional setup for migrations: Read more: https://pris.ly/d/database-comments
model users {
  id              String            @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  steam_id        String?           @unique @db.VarChar
  email           String?           @db.VarChar
  password_hash   String?           @db.VarChar
  created_at      DateTime?         @default(now()) @db.Timestamptz(6)
  sessions        sessions[]
  user_categories user_categories[]
  user_embeddings user_embeddings[]
  user_genres     user_genres[]
  user_tags       user_tags[]
}
