NODE_ENV=
PORT=
DATABASE_URL=
# TLS do bazy: disable | no-verify | verify (domyślnie: dev=disable, prod=verify)
# Tunel SSH (localhost) -> disable; VPS z self-signed cert -> no-verify
DB_SSL=disable
STEAM_API_KEY=
SESSION_SECRET=
OPENAI_API_KEY=
# Adres frontendu (redirecty po logowaniu Steam, CORS). Domyślnie http://localhost:5137
FRONTEND_URL=http://localhost:5137
# Dzienne limity OpenAI (text-embedding-3-small = $0.02/1M tokenów).
# 2M/konto ~ $0.04/dzień; 10M globalnie ~ $0.20/dzień (twardy sufit ~$6/mies).
OPENAI_TOKENS_USER_DAY=2000000
OPENAI_TOKENS_GLOBAL_DAY=10000000
USER_PROFILE_BUILDS_PER_DAY=4
# Retencja historii zużycia (embedding_usage_daily) w dniach - starsze wiersze
# są usuwane przy starcie serwera i co 24h. Min. 7.
USAGE_RETENTION_DAYS=90