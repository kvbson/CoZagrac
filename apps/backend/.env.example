NODE_ENV=
PORT=
DATABASE_URL=
# TLS do bazy: disable | no-verify | verify (domyślnie: dev=disable, prod=verify)
# Tunel SSH (localhost) -> disable; VPS z self-signed cert -> no-verify
DB_SSL=disable
STEAM_API_KEY=
SESSION_SECRET=
OPENAI_API_KEY=
# Adres frontendu (redirecty po logowaniu Steam, CORS). Domyślnie http://localhost:5137
FRONTEND_URL=http://localhost:5137